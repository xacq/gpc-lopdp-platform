# Copy this file to deploy/docker.env. Never commit the resulting file.
COMPOSE_PROJECT_NAME=gpc-lopdp-vinesa
TENANT_ENV_FILE=deploy/docker.env
HTTP_PORT=8080

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=generate-a-unique-secret
DJANGO_DEBUG=False
DJANGO_ADMIN_ENABLED=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
PUBLIC_SITE_URL=http://localhost:8080

POSTGRES_DB=gpc_lopdp_vinesa
POSTGRES_USER=gpc_lopdp_vinesa
POSTGRES_PASSWORD=replace-with-a-unique-password
DATABASE_URL=postgresql://gpc_lopdp_vinesa:replace-with-a-unique-password@db:5432/gpc_lopdp_vinesa

PII_ENCRYPTION_ACTIVE_VERSION=1
PII_ENCRYPTION_KEY_V1=generate-a-32-byte-base64-key
LOOKUP_HMAC_ACTIVE_VERSION=1
LOOKUP_HMAC_KEY_V1=generate-an-independent-32-byte-base64-key

MFA_TOTP_ISSUER=VINESA
PRIVATE_STORAGE_ROOT=/app/private_storage
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=privacidad@vinesa.com.ec
EMAIL_WORKER_BATCH_SIZE=100
EMAIL_WORKER_INTERVAL_SECONDS=60
PUBLIC_UPLOAD_MALWARE_SCANNER=apps.evidence.services.scanners.ClamAVCommandScanner
CLAMAV_EXECUTABLE=clamscan
