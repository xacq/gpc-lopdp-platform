DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ADMIN_ENABLED=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8000

# Generate independent values for every company.
PII_ENCRYPTION_ACTIVE_VERSION=1
PII_ENCRYPTION_KEY_V1=
LOOKUP_HMAC_ACTIVE_VERSION=1
LOOKUP_HMAC_KEY_V1=

# Production HTTPS (disable only for controlled non-production diagnostics)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DATABASE_URL=postgresql://gpc_lopdp:change-me@127.0.0.1:5432/gpc_lopdp

# Public portal token lifetimes (seconds)
PUBLIC_EMAIL_VERIFICATION_TTL_SECONDS=86400
PUBLIC_TRACKING_TTL_SECONDS=7776000

# Administrative dashboard and assignment workload
DASHBOARD_DUE_SOON_DAYS=7
ASSIGNMENT_CAPACITY_PER_USER=25

# SMTP / encrypted communication outbox
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=noreply@example.test
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_MINUTES=5

# Private encrypted uploads and malware scanning
PRIVATE_STORAGE_ROOT=C:/secure/gpc-lopdp-private
PUBLIC_TEMPORARY_UPLOAD_TTL_SECONDS=3600
PUBLIC_UPLOAD_MALWARE_SCANNER=apps.evidence.services.scanners.ClamAVCommandScanner
CLAMAV_EXECUTABLE=clamscan
MALWARE_SCAN_TIMEOUT_SECONDS=30
PORTABILITY_DOWNLOAD_TTL_SECONDS=86400
PORTABILITY_RIGHT_CODES=PORTABILITY
DATA_UPLOAD_MAX_NUMBER_FILES=3
FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
